#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
#
# Procd init script for the Airoha EN7581 OMCI daemon (omcid).
# Connects to the xpon-portable driver's /dev/airoha-xgs-omcc OMCC device.

USE_PROCD=1
START=90
STOP=10

PROG=/usr/sbin/omcid
DEVICE=/dev/airoha-xgs-omcc

get_serial() {
	uci -q get omcid.@omcid[0].serial
}

start_service() {
	serial="$(get_serial)"
	serial_arg=""
	[ -n "$serial" ] && serial_arg="-serial $serial"

	procd_open_instance
	procd_set_param command "$PROG" \
		-transport device \
		-device "$DEVICE" \
		-pon-mode gpon \
		$serial_arg
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger omcid
}
