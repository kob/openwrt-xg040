#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
#
# Procd init script for the xpon-portable PON driver configuration.
#
# Loads the xpon.ko kernel module with the correct pon_mode parameter,
# then pushes the ONU serial number / password into the driver's sysfs
# interface. Must run BEFORE omcid (START=85 < 90) so the OMCC char device
# is ready when omcid probes it.

USE_PROCD=1
START=85
STOP=15

XPON_KO=/lib/modules/$(uname -r)/xpon.ko
XPON_SYSFS=/sys/bus/platform/drivers/xpon
XPON_DEV_SYSFS=""
KMOD_PARAM_PON_MODE=""

# Locate the xpon platform device's sysfs path (the driver registers a
# platform device with dev_groups = xpon_groups, so sn/password/onu_state
# appear under /sys/bus/platform/devices/<xpon-node>/).
find_xpon_sysfs() {
	local dev
	for dev in /sys/bus/platform/devices/*; do
		case "$(readlink -f "$dev/driver")" in
			*/xpon)
				XPON_DEV_SYSFS="$dev"
				return 0
				;;
		esac
	done
	# Fallback: the driver name is "xpon", devices may be under of-platform.
	for dev in /sys/bus/platform/devices/*xpon* /sys/bus/of-platform/devices/*xpon*; do
		[ -d "$dev" ] && [ -f "$dev/onu_state" ] && {
			XPON_DEV_SYSFS="$dev"
			return 0
		}
	done
	return 1
}

get_uci() {
	local key="$1"
	uci -q get xpon.@xpon[0]."$key"
}

start_service() {
	local pon_mode sn password epon_mac

	pon_mode=$(get_uci pon_mode)
	sn=$(get_uci sn)
	password=$(get_uci password)
	epon_mac=$(get_uci epon_onu_mac)

	# Detect whether the *factory* ALU omciMgr is the active PON stack
	# (some XG-040G-MD units run the original firmware under OpenWrt's
	# kernel, with omciMgr + the vendor xpon_10g.ko still driving the
	# hardware).  When that is the case, we must NOT insmod xpon.ko —
	# the two drivers would collide on the same MAC register window.
	# Instead we mirror the factory's mode/authtype plumbing so omciMgr
	# picks up the user's SN/password/mode via /tmp/omciini.
	local factory_omci_running=0
	if pidof omciMgr >/dev/null 2>&1; then
		factory_omci_running=1
		logger -t xpon "factory omciMgr detected — bridging config to /tmp/omciini"
	fi

	# 1a. Factory-bridge path: write /tmp/omciini/* files consumed by omciMgr.
	if [ "$factory_omci_running" = "1" ]; then
		mkdir -p /tmp/omciini

		# Map UCI pon_mode -> ritool's string form.  omciMgr reads the system
		# uplink mode from ri_get_uplink_mode() at startup; that comes from the
		# RI partition (not writable here), so this only affects the authtype
		# / SN plumbing which omciMgr re-reads periodically.
		case "$pon_mode" in
			0) echo "GPON"  > /tmp/omciini/pon_authtype 2>/dev/null ;;
			1) echo "EPON"  > /tmp/omciini/pon_authtype 2>/dev/null ;;
			2) echo "XGPON1" > /tmp/omciini/pon_authtype 2>/dev/null ;;
			3) echo "XEPON" > /tmp/omciini/pon_authtype 2>/dev/null ;;
		esac
		# /tmp/pon_authtype is the secondary copy (omciMgr checks both).
		cp /tmp/omciini/pon_authtype /tmp/pon_authtype 2>/dev/null

		# Vendor marker — matches ALCL (Alcatel-Lucent) on stock firmware.
		echo "ALCL" > /tmp/omcivendor 2>/dev/null

		# SN / password: omciMgr reads LOID from /tmp/newloid.txt when the
		# OLT uses LOID-based auth.  For SN auth, /tmp/ont_register_info is
		# consulted.  We write both so omciMgr picks up whichever the OLT
		# requires.
		if [ -n "$sn" ]; then
			echo "$sn" > /tmp/ont_register_info 2>/dev/null
		fi
		if [ -n "$password" ]; then
			echo "$password" > /tmp/newloid.txt 2>/dev/null
		fi

		# Write the sysfs path marker so the LuCI page can find the platform
		# device (factory driver exposes a different sysfs path than
		# xpon-portable; the page tolerates either).
		mkdir -p /var/run/xpon
		# Locate the factory's PON netdev sysfs (pon / omci interfaces).
		for netif in pon omci; do
			if [ -d "/sys/class/net/$netif" ]; then
				echo "/sys/class/net/$netif" > /var/run/xpon/sysfs_path
				break
			fi
		done

		# Trigger omciMgr to re-read by toggling its startup file.  omciMgr
		# polls /tmp/omci_startup — removing it causes a re-init pass.
		rm -f /tmp/omci_startup 2>/dev/null

		logger -t xpon "factory-bridge: pon_authtype=$(cat /tmp/omciini/pon_authtype 2>/dev/null) sn=$sn"
		procd_set_param env FACTORY_OMCI=1
		procd_open_instance
		procd_set_param command /bin/true   # placeholder; we just track state
		procd_set_param respawn
		procd_close_instance
		return 0
	fi

	# 1b. xpon-portable path: load the kernel module if not already loaded.
	if ! lsmod | grep -q '^xpon '; then
		if [ -n "$pon_mode" ]; then
			KMOD_PARAM_PON_MODE="pon_mode=$pon_mode"
		fi
		if [ -n "$epon_mac" ]; then
			# Only valid for EPON/XEPON modes (mode 1/3).
			KMOD_PARAM_PON_MODE="$KMOD_PARAM_PON_MODE epon_onu_mac_override=$epon_mac"
		fi
		if insmod "$XPON_KO" $KMOD_PARAM_PON_MODE 2>/dev/null; then
			logger -t xpon "loaded xpon.ko (pon_mode=$pon_mode)"
		else
			logger -t xpon "ERROR: failed to load xpon.ko"
			# Module may already be built-in; continue if sysfs exists.
		fi
	fi

	# 2. Wait for the platform device to appear (driver probe is async).
	local tries=0
	while ! find_xpon_sysfs && [ $tries -lt 50 ]; do
		tries=$((tries + 1))
		sleep 0.1
	done

	if [ -z "$XPON_DEV_SYSFS" ]; then
		logger -t xpon "ERROR: xpon platform device not found after 5s"
		return 1
	fi

	logger -t xpon "platform device: $XPON_DEV_SYSFS"

	# 3. Push SN / password into the driver via sysfs.
	if [ -n "$sn" ]; then
		echo -n "$sn" > "$XPON_DEV_SYSFS/sn" 2>/dev/null && \
			logger -t xpon "SN set to $sn"
	fi
	if [ -n "$password" ]; then
		echo -n "$password" > "$XPON_DEV_SYSFS/password" 2>/dev/null && \
			logger -t xpon "password set"
	fi

	# 4. Export the sysfs path for omcid and LuCI to use.
	mkdir -p /var/run/xpon
	echo "$XPON_DEV_SYSFS" > /var/run/xpon/sysfs_path

	# 5. Wait for the OMCC char device (omcid needs it).
	if [ ! -c /dev/airoha-xgs-omcc ]; then
		tries=0
		while [ ! -c /dev/airoha-xgs-omcc ] && [ $tries -lt 100 ]; do
			tries=$((tries + 1))
			sleep 0.1
		done
	fi

	if [ ! -c /dev/airoha-xgs-omcc ]; then
		logger -t xpon "WARNING: /dev/airoha-xgs-omcc not ready; omcid may fail"
	fi

	logger -t xpon "init done"
}

stop_service() {
	# Unloading the module also tears down the char devices.
	if lsmod | grep -q '^xpon '; then
		rmmod xpon 2>/dev/null && logger -t xpon "xpon.ko unloaded"
	fi
	rm -f /var/run/xpon/sysfs_path
}

service_triggers() {
	procd_add_reload_trigger xpon
}
