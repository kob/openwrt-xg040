# SPDX-License-Identifier: Apache-2.0
#
# xpon UCI configuration for the EN7581 PON MAC driver (kmod-xpon-portable).
#
# This file is consumed by /etc/init.d/xpon, which:
#   1. loads xpon.ko with the requested pon_mode module parameter
#   2. writes sn/password into the driver's sysfs interface (/sys/bus/.../xpon/...)
#   3. ensures the /dev/airoha-xgs-omcc character device is ready before omcid starts
#
# PON protocol mode: 0=GPON, 1=EPON, 2=XGS-PON, 3=10G-EPON(XEPON).
# Default GPON (the common deployment on XG-040G-MD).
config xpon
	option pon_mode '0'

	# ONU Serial Number (4 vendor chars + 4 hex digits, e.g. "ALCL12345678").
	# Leave empty to use the factory-programmed SN from the nvmem factory partition.
	# option sn 'ALCL00000000'

	# GPON Password / LOID (up to 10 ASCII chars).
	# Leave empty if the OLT uses SN-based authentication only.
	# option password ''

	# EPON ONU MAC override (AA:BB:CC:DD:EE:FF). Only used in EPON/XEPON mode.
	# Leave empty to use the device-tree local-mac-address.
	# option epon_onu_mac ''
